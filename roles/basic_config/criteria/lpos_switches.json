{
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "properties": {
      "purpose": {
        "type": "integer",
        "enum": [0, 1, 2],
        "description": "Switch purpose: 0=core, 1=participant, 2=mixed"
      },
      "onboarding_vlan_number": {
        "type": "integer",
        "description": "VLAN number for onboarding (required when purpose is 1 or 2)"
      },
      "desc": {
        "type": "string",
        "description": "Description for Switch"
      },
      "user": {
        "type": "string",
        "description": "Username to connect to the Switch"
      },
      "pw": {
        "type": "string",
        "description": "Password to connect to the Switch"
      },
      "port_numbering_offset": {
        "type": "integer",
        "description": "Offset for switch port numbering"
      }
    },
    "additionalProperties": false
  }
}
